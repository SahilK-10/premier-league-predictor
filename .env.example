```env
# ============================================================
# Premier League Predictor — Environment Variables
# ============================================================

# football-data.org
# Get a free API token from https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# Supabase
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# Direct PostgreSQL connection string from Supabase.
# Project Settings -> Database -> Connection string.
DATABASE_URL=

# Optional bookmaker odds provider.
# Leave blank for now; odds ingestion will support this later.
API_FOOTBALL_KEY=

# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# Model configuration
MODEL_RANDOM_STATE=42
POISSON_MAX_GOALS=7
```
